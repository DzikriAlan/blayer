generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Video beranda Blayer
//
// Diisi scraper harian (scripts/syncVideos.ts, jam 10.00 WIB lewat GitHub
// Actions) dari hasil pencarian YouTube per kategori. Browser mengambilnya
// sekali sehari lalu menyimpannya di localStorage. Video yang terbit lebih dari
// 3 hari lalu dihapus pada scrape berikutnya.
// ---------------------------------------------------------------------------

model Video {
  // Satu video bisa masuk lebih dari satu kategori, jadi kuncinya pasangan keduanya
  id              String
  category        String
  url             String
  isShort         Boolean  @default(false) @map("is_short")
  title           String
  channel         String
  channelId       String   @map("channel_id")
  channelUrl      String   @map("channel_url")
  verifiedChannel Boolean  @default(false) @map("verified_channel")
  duration        String
  views           Int      @default(0)
  isLive          Boolean  @default(false) @map("is_live")
  thumbnail       String
  // Perkiraan waktu terbit: waktu scrape dikurangi umur yang ditulis YouTube ("16 jam lalu")
  publishedAt     DateTime @map("published_at")
  scrapedAt       DateTime @map("scraped_at")

  @@id([category, id])
  @@index([scrapedAt])
  @@index([publishedAt])
  @@map("videos")
}
