generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id          String   @id @default(cuid())
  userId      String
  slug        String?  @unique
  title       String
  description String?  @db.Text
  purpose     String?  @db.Text
  templateId  String?
  bannerUrl   String?
  meetingUrl  String?
  videoUrl    String?
  qrisUrl     String?
  priceAmount Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields    FormField[]
  responses FormResponse[]
  analyses  FormAnalysis[]

  @@index([userId])
  @@index([isPublished, createdAt, id])
  @@map("forms")
}

model FormField {
  id          String    @id @default(cuid())
  formId      String
  label       String
  description String?   @db.Text
  placeholder String?
  type        FieldType @default(SHORT_TEXT)
  isRequired  Boolean   @default(false)
  options     Json?
  order       Int       @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id              String   @id @default(cuid())
  formId          String
  respondentName  String?
  respondentEmail String?
  answers         Json
  durationSeconds Int?
  idempotencyKey  String?
  createdAt       DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, idempotencyKey])
  @@index([formId])
  @@index([formId, createdAt, id])
  @@map("form_responses")
}

model FormAnalysis {
  id             String   @id @default(cuid())
  formId         String
  purpose        String   @db.Text
  summary        String   @db.Text
  recommendation String   @db.Text
  ranking        Json
  createdAt      DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_analyses")
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  URL
  DATE
  TIME
  SELECT
  RADIO
  CHECKBOX
  RATING
  SCALE
  MENU
  PAYMENT
}

model RateLimitHit {
  id    String   @id @default(cuid())
  key   String
  stamp DateTime

  @@index([key, stamp])
  @@index([stamp])
  @@map("rate_limit_hits")
}

// ---------------------------------------------------------------------------
// AI Agent Platform — Phase 1 (lihat PRD.md §5)
//
// Blayer menyimpan konfigurasi agent dan catatan eksekusinya. Data bisnis milik
// project consumer tidak pernah masuk ke sini; yang tersimpan hanya prompt,
// pilihan model, kredensial provider terenkripsi, dan jejak pemakaian.
// ---------------------------------------------------------------------------

enum AgentProvider {
  ANTHROPIC
  OPENAI
}

enum AgentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum AgentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgentEffort {
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

enum AgentRunStatus {
  SUCCEEDED
  FAILED
  PENDING_CONFIRMATION
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys      ProjectApiKey[]
  providerKeys ProviderCredential[]
  agents       Agent[]
  runs         AgentRun[]
  integrations Integration[]
  documents    KnowledgeDocument[]
  sessions     AgentSession[]

  @@map("projects")
}

model ProjectApiKey {
  id          String           @id @default(cuid())
  projectId   String
  name        String
  environment AgentEnvironment @default(DEVELOPMENT)
  prefix      String
  hash        String           @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_api_keys")
}

model ProviderCredential {
  id          String           @id @default(cuid())
  projectId   String
  provider    AgentProvider
  environment AgentEnvironment
  secret      String           @db.Text
  hint        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, environment])
  @@map("provider_credentials")
}

model Agent {
  id                  String   @id @default(cuid())
  projectId           String
  slug                String
  name                String
  description         String?  @db.Text
  productionVersionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productionVersion AgentVersion?  @relation("AgentProduction", fields: [productionVersionId], references: [id], onDelete: SetNull)
  versions          AgentVersion[] @relation("AgentVersions")
  runs              AgentRun[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("agents")
}

model AgentVersion {
  id           String             @id @default(cuid())
  agentId      String
  version      Int
  status       AgentVersionStatus @default(DRAFT)
  instructions String             @db.Text
  provider     AgentProvider
  model        String
  effort       AgentEffort        @default(HIGH)
  maxTokens    Int                @default(16000)
  temperature  Float?
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  agent         Agent                  @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  productionFor Agent?                 @relation("AgentProduction")
  runs          AgentRun[]
  tools         AgentVersionTool[]
  documents     AgentVersionDocument[]

  @@unique([agentId, version])
  @@index([agentId])
  @@map("agent_versions")
}

model AgentRun {
  id             String           @id @default(cuid())
  projectId      String
  agentId        String
  agentVersionId String
  environment    AgentEnvironment
  status         AgentRunStatus
  provider       AgentProvider
  model          String
  input          String           @db.Text
  output         String?          @db.Text
  errorCode      String?
  errorMessage   String?          @db.Text
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  costUsd        Float?
  latencyMs      Int
  sessionId      String?
  createdAt      DateTime         @default(now())

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion    @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  session      AgentSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  toolCalls    AgentToolCall[]

  @@index([agentId, createdAt, id])
  @@index([projectId, createdAt, id])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Tool, Knowledge, Memory (lihat PRD.md §4 dan §5)
//
// Blayer hanya menyimpan KONTRAK tool: nama, deskripsi, skema masukan, method,
// dan potongan endpointnya. Yang menjalankan tetap endpoint milik project, dan
// isinya tidak pernah ikut tersimpan di sini.
// ---------------------------------------------------------------------------

enum IntegrationAuth {
  NONE
  BEARER
  HEADER
}

enum ToolMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum ToolPermission {
  READ
  WRITE
}

enum ToolCallStatus {
  SUCCEEDED
  FAILED
  PENDING_CONFIRMATION
  REJECTED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

model Integration {
  id          String          @id @default(cuid())
  projectId   String
  slug        String
  name        String
  description String?         @db.Text
  baseUrl     String
  auth        IntegrationAuth @default(NONE)
  authHeader  String?
  secret      String?         @db.Text
  hint        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tools   ToolDefinition[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("integrations")
}

model ToolDefinition {
  id            String         @id @default(cuid())
  integrationId String
  name          String
  description   String         @db.Text
  method        ToolMethod     @default(GET)
  path          String
  permission    ToolPermission @default(READ)
  inputSchema   Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  integration Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  versions    AgentVersionTool[]
  calls       AgentToolCall[]

  @@unique([integrationId, name])
  @@index([integrationId])
  @@map("tool_definitions")
}

model AgentVersionTool {
  id               String @id @default(cuid())
  agentVersionId   String
  toolDefinitionId String

  agentVersion   AgentVersion   @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  toolDefinition ToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)

  @@unique([agentVersionId, toolDefinitionId])
  @@index([agentVersionId])
  @@map("agent_version_tools")
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions AgentVersionDocument[]

  @@index([projectId])
  @@map("knowledge_documents")
}

model AgentVersionDocument {
  id             String @id @default(cuid())
  agentVersionId String
  documentId     String

  agentVersion AgentVersion      @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([agentVersionId, documentId])
  @@index([agentVersionId])
  @@map("agent_version_documents")
}

model AgentSession {
  id          String           @id @default(cuid())
  projectId   String
  agentId     String
  environment AgentEnvironment
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages AgentMessage[]
  runs     AgentRun[]

  @@index([projectId, agentId])
  @@map("agent_sessions")
}

model AgentMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      AgentMessageRole
  content   String           @db.Text
  createdAt DateTime         @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}

model AgentToolCall {
  id               String         @id @default(cuid())
  runId            String
  toolDefinitionId String
  name             String
  permission       ToolPermission
  status           ToolCallStatus
  input            Json
  output           String?        @db.Text
  errorMessage     String?        @db.Text
  latencyMs        Int            @default(0)
  // Percakapan sampai titik tool ini dipanggil, supaya eksekusi bisa dilanjutkan
  // setelah operator mengonfirmasi tool yang mengubah data.
  state            Json?
  providerCallId   String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())

  run            AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolDefinition ToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_tool_calls")
}
