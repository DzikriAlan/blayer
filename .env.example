# Salin berkas ini menjadi .env, lalu isi sesuai petunjuk tiap bagian.
# Setelah terisi, periksa hasilnya dengan: npm run db:check
#


# ══════════════════════════════════════════════════════════════════════════════
# 1. BASIS DATA — cukup salah satu dari tiga cara di bawah
# ══════════════════════════════════════════════════════════════════════════════
# Urutan pembacaannya: DATABASE_URL → pooler → koneksi langsung.
# Nilainya harus diawali postgresql://. Alamat project Supabase
# (https://xxxx.supabase.co) bukan connection string — kalau itu yang terisi,
# nilainya diabaikan dengan peringatan di log.

# ── Cara A: satu connection string ────────────────────────────────────────────
# Supabase: tombol "Connect" di atas dashboard → tab "Connection string".
#   • Deploy serverless (Vercel, Lambda) WAJIB memakai "Transaction pooler"
#     (host aws-0-<region>.pooler.supabase.com, port 6543). Host koneksi
#     langsung db.<ref>.supabase.co hanya punya alamat IPv6, sedangkan function
#     di sana keluar lewat IPv4 — hasilnya 503 DATABASE_UNAVAILABLE.
#   • Ganti bagian [YOUR-PASSWORD] dengan sandi basis datamu. Kalau penandanya
#     dibiarkan, isinya diambil dari SUPABASE_PASSWORD di bawah.
# Postgres sendiri: postgresql://<user>:<sandi>@<host>:5432/<nama-basis-data>
DATABASE_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Khusus migrasi, yang butuh mode sesi (port 5432). Boleh dikosongkan kalau
# DATABASE_URL sudah menunjuk port 5432.
# Supabase: "Connect" → "Session pooler" atau "Direct connection".
DIRECT_URL=""

# ── Cara B: connection string langsung dari dashboard ─────────────────────────
# Supabase: "Connect" → "Direct connection". Boleh disalin apa adanya beserta
# penanda [YOUR-PASSWORD]; yang mengisi penandanya SUPABASE_PASSWORD.
# Dipakai untuk migrasi, dan untuk aplikasi kalau jaringanmu punya IPv6.
SUPABASE_DIRECT_CONNECTION_STRING="postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres"

# ── Cara C: biar aplikasi yang menyusun alamat pooler ─────────────────────────
# Sandi basis data — BUKAN API key.
# Supabase: Project Settings → Database → Database password. Kalau lupa, tombol
# "Reset database password" di halaman yang sama membuat sandi baru.
SUPABASE_PASSWORD=""

# Wilayah project. Terbaca pada host di connection string: bagian <region> dari
# aws-0-<region>.pooler.supabase.com. Ada juga di Project Settings → General.
SUPABASE_REGION="ap-northeast-2"

# Ref project (20 huruf, bagian depan alamat project). Diambil otomatis dari
# SUPABASE_URL, jadi boleh diisi nama yang enak dibaca saja.
# Supabase: Project Settings → General → Reference ID.
SUPABASE_PROJECT=""

# Diisi hanya kalau host pooler-mu tidak mengikuti pola aws-0-<region>.
SUPABASE_POOLER_HOST=""
# 6543 = mode transaksi (bawaan, untuk aplikasi), 5432 = mode sesi.
SUPABASE_POOLER_PORT=""


# ══════════════════════════════════════════════════════════════════════════════
# 2. SUPABASE — di luar basis data
# ══════════════════════════════════════════════════════════════════════════════
# Alamat project. Dipakai next.config.js untuk melonggarkan CSP, dan menjadi
# sumber ref project di atas. Nama SUPABASE_PROJECT_URL juga diterima.
# Supabase: Project Settings → Data API → Project URL.
SUPABASE_URL="https://<ref>.supabase.co"

# Kunci publik yang boleh terbaca browser (dulu bernama anon key).
# Supabase: Project Settings → API Keys → publishable key.
SUPABASE_PUBLISHABLE_KEY=""


# ══════════════════════════════════════════════════════════════════════════════
# 3. OPSIONAL
# ══════════════════════════════════════════════════════════════════════════════
# Ambang permintaan lambat yang dicatat di log, dalam milidetik (bawaan 1000).
SLOW_REQUEST_MS=""

# Tujuan kiriman log level error — URL incoming webhook Slack atau Discord.
ALERT_WEBHOOK_URL=""


# ══════════════════════════════════════════════════════════════════════════════
# 4. SCRAPE HARIAN (GitHub Actions)
# ══════════════════════════════════════════════════════════════════════════════
# .github/workflows/sync-videos.yml menjalankan `npm run videos:sync` setiap jam
# 10.00 WIB. Isi secret repo GitHub (Settings → Secrets and variables → Actions):
#   DATABASE_URL      — Supabase "Transaction pooler" (port 6543); runner GitHub
#                       hanya IPv4 sehingga koneksi langsung db.<ref> tidak bisa.
#   SUPABASE_PASSWORD — kalau DATABASE_URL masih memuat [YOUR-PASSWORD].
