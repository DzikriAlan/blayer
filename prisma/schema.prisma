// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Di serverless, DATABASE_URL harus menunjuk ke pooler (pgbouncer) supaya
  // koneksi tidak habis. Migrasi dijalankan terpisah memakai koneksi langsung:
  // lihat DIRECT_URL di .env.example.
  url      = env("DATABASE_URL")
}

model Form {
  id          String   @id @default(cuid())
  /// Pemilik form — id pengguna Supabase Auth. Daftar form dan dashboard hasil
  /// disaring dengan kolom ini, jadi satu akun tidak bisa membuka milik akun lain.
  userId      String
  title       String
  description String?  @db.Text
  /// Tujuan form untuk AI. Null/kosong berarti analisis AI dimatikan.
  purpose     String?  @db.Text
  /// Id template asal (exam/psychometric/dst). Menentukan bentuk dashboard hasil.
  templateId  String?
  /// URL banner acara di Supabase Storage. Hanya dipakai template pendaftaran.
  bannerUrl   String?
  /// Link Google Meet acara, dibagikan setelah peserta berhasil mendaftar.
  meetingUrl  String?
  /// Link video kelas, dibuka setelah peserta membayar dan mengisi form.
  videoUrl    String?
  /// URL gambar QRIS milik pembuat form, dipindai pembayar saat memilih QRIS.
  qrisUrl     String?
  /// Harga tetap form berbayar yang tidak memakai field menu, mis. kursus.
  priceAmount Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields    FormField[]
  responses FormResponse[]
  analyses  FormAnalysis[]

  @@index([userId])
  @@map("forms")
}

model FormField {
  id          String    @id @default(cuid())
  formId      String
  label       String
  description String?   @db.Text
  placeholder String?
  type        FieldType @default(SHORT_TEXT)
  isRequired  Boolean   @default(false)
  options     Json?
  order       Int       @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id              String   @id @default(cuid())
  formId          String
  respondentName  String?
  respondentEmail String?
  answers         Json
  /// Lama pengerjaan dalam detik, dihitung dari form dibuka sampai dikirim.
  durationSeconds Int?
  createdAt       DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_responses")
}

model FormAnalysis {
  id             String   @id @default(cuid())
  formId         String
  purpose        String   @db.Text
  summary        String   @db.Text
  recommendation String   @db.Text
  ranking        Json
  createdAt      DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_analyses")
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  URL
  DATE
  TIME
  SELECT
  RADIO
  CHECKBOX
  RATING
  SCALE
  /// Daftar menu bergambar. Tiap opsi: "Nama|Harga|URL Gambar".
  MENU
  /// Pilihan metode pembayaran. Tiap opsi: "Metode|Petunjuk".
  PAYMENT
}
