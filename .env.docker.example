# Rahasia untuk docker compose. Salin ke .env.docker lalu isi.
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-panjang

# 32 byte acak dalam base64: openssl rand -base64 32
BLAYER_ENCRYPTION_KEY=

# Kredensial operator Console. Wajib diganti sebelum dipakai; jangan pakai sandi pendek.
BLAYER_ADMIN_USERNAME=admin
BLAYER_ADMIN_PASSWORD=ganti-dengan-kata-sandi-admin-yang-panjang

# Opsional: mengganti nilainya membatalkan semua sesi Console yang beredar.
BLAYER_SESSION_SECRET=

# Jumlah proxy tepercaya di depan aplikasi (0 kalau langsung terbuka).
TRUST_PROXY_HOPS=0
BLAYER_PORT=3000
