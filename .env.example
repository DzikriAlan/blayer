# ─── Basis data ───────────────────────────────────────────────────────────────
# Cukup salah satu dari tiga cara di bawah. Urutan pembacaannya:
# DATABASE_URL → SUPABASE_DIRECT_CONNECTION_STRING → SUPABASE_PROJECT + wilayah.

# 1. Postgres apa pun. Di serverless (Vercel) pakai URL pooler — koneksi langsung
#    akan habis karena tiap function instance membuka pool-nya sendiri.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Koneksi langsung (port 5432) untuk migrasi; pooler tidak bisa dipakai migrasi.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# 2. Supabase, connection string dari dashboard. Penanda [YOUR-PASSWORD] boleh
#    dibiarkan apa adanya — nilainya diisi dari SUPABASE_PASSWORD.
SUPABASE_DIRECT_CONNECTION_STRING="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"
SUPABASE_PASSWORD=""

# 3. Supabase lewat pooler, disusun dari project dan wilayahnya.
SUPABASE_PROJECT=""
SUPABASE_REGION="ap-southeast-1"
# SUPABASE_POOLER_HOST=""   # kalau host pooler-nya bukan pola aws-0-<region>
# SUPABASE_POOLER_PORT="5432"

# Hanya dipakai next.config.js untuk melonggarkan CSP ke domain Supabase.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# ─── Wajib ────────────────────────────────────────────────────────────────────
# 32 byte acak base64: openssl rand -base64 32
# Membuka kredensial provider dan integration. Kalau diganti, kredensial lama
# tidak bisa dibaca lagi dan eksekusi agent menjawab 503 CONFIG_MISSING.
BLAYER_ENCRYPTION_KEY=""

# ─── Console ──────────────────────────────────────────────────────────────────
# Tanpa diisi, bawaannya admin / admin123 dan Console memasang spanduk peringatan.
BLAYER_ADMIN_USERNAME=""
BLAYER_ADMIN_PASSWORD=""
BLAYER_SESSION_SECRET=""
# Token mentah untuk skrip, CI, dan curl — dipakai sebagai Bearer tanpa login.
BLAYER_ADMIN_TOKEN=""

# ─── Opsional ─────────────────────────────────────────────────────────────────
# Jumlah proxy tepercaya di depan aplikasi. Wajib diisi di produksi di balik
# proxy, kalau tidak rate limit membaca IP proxy, bukan IP pemanggil.
TRUST_PROXY_HOPS=1
# memory | postgres. Kosong: Redis kalau kredensialnya ada, selain itu Postgres
# di produksi dan memori proses di pengembangan.
RATE_LIMIT_STORE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Ambang permintaan lambat yang dicatat di log (ms, bawaan 1000).
SLOW_REQUEST_MS=
# Tujuan kiriman log level error.
ALERT_WEBHOOK_URL=
# Kosongkan untuk memakai origin yang sama dengan aplikasi.
NEXT_PUBLIC_API_BASE_URL=""
# Endpoint sebentuk Chat Completions selain OpenAI (gateway, proxy, model lokal).
OPENAI_BASE_URL=
