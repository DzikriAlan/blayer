generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  purpose     String?  @db.Text
  templateId  String?
  bannerUrl   String?
  meetingUrl  String?
  videoUrl    String?
  qrisUrl     String?
  priceAmount Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields    FormField[]
  responses FormResponse[]
  analyses  FormAnalysis[]

  @@index([userId])
  @@index([isPublished, createdAt, id])
  @@map("forms")
}

model FormField {
  id          String    @id @default(cuid())
  formId      String
  label       String
  description String?   @db.Text
  placeholder String?
  type        FieldType @default(SHORT_TEXT)
  isRequired  Boolean   @default(false)
  options     Json?
  order       Int       @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id              String   @id @default(cuid())
  formId          String
  respondentName  String?
  respondentEmail String?
  answers         Json
  durationSeconds Int?
  createdAt       DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([formId, createdAt, id])
  @@map("form_responses")
}

model FormAnalysis {
  id             String   @id @default(cuid())
  formId         String
  purpose        String   @db.Text
  summary        String   @db.Text
  recommendation String   @db.Text
  ranking        Json
  createdAt      DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_analyses")
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  URL
  DATE
  TIME
  SELECT
  RADIO
  CHECKBOX
  RATING
  SCALE
  MENU
  PAYMENT
}

model RateLimitHit {
  id    String   @id @default(cuid())
  key   String
  stamp DateTime

  @@index([key, stamp])
  @@index([stamp])
  @@map("rate_limit_hits")
}
