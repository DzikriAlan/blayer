# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blayer?schema=public"

# NextAuth
# Generate NEXTAUTH_SECRET using: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-this-in-production"

# Google OAuth (used by NextAuth sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# DeepSeek (OpenAI-compatible chat completions API used for chat + agent generation)
DEEPSEEK_API_KEY=""

# Supabase Storage (agent avatar image upload)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Environment
NODE_ENV="development"
