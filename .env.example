# Postgres. Di serverless (Vercel) wajib memakai URL pooler — koneksi langsung
# akan habis karena tiap function instance membuka pool-nya sendiri.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Koneksi langsung (port 5432). Migrasi tidak bisa lewat pooler, jadi jalankan:
#   DATABASE_URL="$DIRECT_URL" npm run db:deploy
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase — dibaca browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase — khusus server. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_BANNER_BUCKET="banner"

# Analisis AI.
ANTHROPIC_API_KEY=""

# Kosongkan untuk memakai origin yang sama dengan aplikasi.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
MAIL_FROM=
TRUST_PROXY_HOPS=1
ALERT_WEBHOOK_URL=
